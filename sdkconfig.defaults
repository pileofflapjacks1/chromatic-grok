# Modified by pileofflapjacks1, 2026: Wi-Fi, NimBLE, custom partition table and DIO flash settings.
# Original: ModRetro oss-chromatic-console-mcu v4.6 (63ed3b6), GPL-3.0.
# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 5.3.0 Project Minimal Configuration
#
CONFIG_APP_PROJECT_VER_FROM_CONFIG=y
CONFIG_APP_PROJECT_VER="0.15.0-grok"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_CHROMATIC_FW_VER_STR="4.6g"
CONFIG_CONSOLE_SORTED_HELP=y
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
CONFIG_LV_COLOR_CHROMA_KEY_HEX=0xFF00FF
CONFIG_LV_USE_ASSERT_STYLE=y
CONFIG_LV_SPRINTF_USE_FLOAT=y
CONFIG_LV_FONT_MONTSERRAT_26=y
CONFIG_LV_FONT_MONTSERRAT_28=y
# Grok reply overlay font: legible 8x8 monospace, 1 bpp, in flash.
CONFIG_LV_FONT_UNSCII_8=y

# GPIO9/GPIO10 are the FPGA UART. QIO flash mode uses those pins.
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y

# Factory app grows past the stock 1MB slot once Wi-Fi and BLE are linked.
# NVS stays at 0x9000 / 24KB so menu settings survive an app reflash.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# BLE peripheral only. NimBLE is smaller than Bluedroid.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BTDM_CTRL_BLE_MAX_CONN=1
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=8192
# CONFIG_BT_NIMBLE_ROLE_CENTRAL is not set
# CONFIG_BT_NIMBLE_ROLE_OBSERVER is not set
# Pairing: LE Secure Connections with passkey (MITM). Bonds persist in NVS.
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MAX_BONDS=3

# Smaller Wi-Fi buffers. This board has no PSRAM.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
# CONFIG_ESP_WIFI_AMPDU_TX_ENABLED is not set
# CONFIG_ESP_WIFI_AMPDU_RX_ENABLED is not set

# Proxy mode speaks plain HTTP to a LAN proxy that holds the API key.
# HTTPS spike: "grok mode direct" calls https://api.x.ai with BLE stopped.
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y
# Common-CA bundle (~40 roots, in flash). api.x.ai chains to GTS Root R4,
# cross-signed by GlobalSign Root CA; both are in the common bundle.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
# TLS heap: allocate record buffers only while in use, free the CA chain and
# config after the handshake. 16 KB in (server records can be that big),
# 4 KB out (our request is ~1.5 KB).
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y

CONFIG_LWIP_MAX_SOCKETS=8

# --- Memory fit (ESP32, no PSRAM). Wi-Fi + NimBLE + LVGL overflowed static
# DRAM by ~21.9 KB and IRAM by ~6.9 KB with the stock settings.
# LVGL allocates from the heap instead of a 32 KB static pool. Same objects,
# same UI; the ESP32 heap includes DRAM that static .bss cannot use.
CONFIG_LV_MEM_CUSTOM=y
# -Os instead of -Og. Smaller code in IRAM and flash.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# Wi-Fi TX/RX hot paths stay in flash. Lower peak throughput, which a short
# HTTP request does not need.
# CONFIG_ESP_WIFI_IRAM_OPT is not set

# --- Wireless updates ("grok update"). ESP-IDF "signed apps without secure
# boot", ECDSA P-256 (Secure Boot V1 signature block). Only the app checks
# signatures, in esp_ota_end() before the boot slot is switched. Nothing is
# signed at build time and no private key is used by the build: releases
# are signed afterwards with espsecure.py sign_data --version 1. The stock
# bootloader is untouched (no boot-time check), no eFuse is written.
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_APPS_ECDSA_SCHEME=y
# CONFIG_SECURE_SIGNED_ON_BOOT_NO_SECURE_BOOT is not set
CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT=y
# CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES is not set
# TEST KEY. Its private half never leaves the build box and is not in git.
# Replace with keys/signature_verification_key.bin (Joe's key) for release.
CONFIG_SECURE_BOOT_VERIFICATION_KEY="keys/TEST_signature_verification_key.bin"
# Rollback is done in the app (grok_update.c); the stock bootloader was not
# built with CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE.
