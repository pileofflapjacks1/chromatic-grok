# Copy to companion/.env and source it in the shell before starting the proxy.
# The key stays on this computer. Do not put it in the firmware or in git.
XAI_API_KEY=
XAI_MODEL=grok-4.7
# Required. Shared secret the Chromatic sends as a Bearer token (>=16 chars).
# python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
GROK_PROXY_TOKEN=
# Default bind is 127.0.0.1. Set to 1 so the handheld on the LAN can reach it.
GROK_PROXY_ALLOW_LAN=
GROK_PROXY_HOST=
GROK_PROXY_PORT=8787
# Optional serial device for companion/chromatic_grok.py
# CHROMATIC_PORT=/dev/cu.usbmodem1101
